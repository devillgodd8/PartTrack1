{
  "version": 2,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://app.reviorcm.com/backend/index.php/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

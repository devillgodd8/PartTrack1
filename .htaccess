<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization & X-API-Key headers in Apache
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:X-API-Key} .
    RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-API-Key}]

    # Route /api requests to backend
    RewriteCond %{DOCUMENT_ROOT}/backend/index.php -f
    RewriteRule ^api/(.*)$ backend/index.php [QSA,L]

    RewriteCond %{DOCUMENT_ROOT}/backend/backend/index.php -f
    RewriteRule ^api/(.*)$ backend/backend/index.php [QSA,L]

    RewriteRule ^api/(.*)$ backend/backend/index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://parttract.vercel.app" "expr=%{HTTP_ORIGIN} =~ /^https:\/\/([a-z0-9-]+\.)?vercel\.app$/ || %{HTTP_ORIGIN} =~ /^http:\/\/localhost(:\d+)?$/"
    Header set Access-Control-Allow-Credentials "true"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, Accept, Origin, X-Requested-With, Cache-Control, Pragma"
</IfModule>
